{
  "name": "dsh-plugin-messaging",
  "version": "0.1.0",
  "description": "Multi-platform messaging bridge for DeepSeek Harness: chat with your dsh sessions from LINE / Telegram / WhatsApp / Discord, with a Settings menu, per-platform config, reply-language translation (EN/中文/ไทย), monthly message counter, and AI working-status.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node ./test/smoke.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "line",
    "telegram",
    "whatsapp",
    "discord",
    "bridge"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
